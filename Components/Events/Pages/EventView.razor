@page "/events/{eventId:int}"
@inject NavigationManager _navigationManager
@inject EventDb _eventDb

@using ApprenticeEventManager.DatabaseServices
@using ApprenticeEventManager.Models

@if (dbEvent == null)
{
    <p>Loading...</p>
}
else
{
    <div class="container vw-100">
        <div class="page-title-container">
            <h2 class="page-title-heading">Sign Up:</h2>
        </div>
        <div class="d-flex justify-content-center">
            <div class="w-50 mt-2 mb-4 form-container">
                <div class="flex-column">
                    <div class="">
                        <div class="">
                            <label>Name:</label>
                        </div>
                        <div class="">
                            <p>@dbEvent.Name</p>
                        </div>
                    </div>
                    <div class="">
                        <div class="">
                            <label>Description:</label>
                        </div>
                        <div class="">
                            <p>@dbEvent.Description</p>
                        </div>
                    </div>
                    <div class="">
                        <div class="">
                            <label>Date:</label>
                        </div>
                        <div class="">
                            <p>@dbEvent.Date</p>
                        </div>
                    </div>
                    <div class="pt-3">
                        <button>Sign Up</button>
                    </div>
                </div>
            </div>
        </div>
    </div>


}


