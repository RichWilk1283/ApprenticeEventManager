@page "/user/{userId:int}"
@* @attribute [Authorize(Roles = "Admin")] *@

@rendermode InteractiveServer
@inject UserDb _userDb
@inject NavigationManager _navigationManager

@using ApprenticeEventManager.DatabaseServices
@using ApprenticeEventManager.Models

<div class="container vw-100">
    <div class="page-title-container">
        <h2 class="page-title-heading">Edit User</h2>
    </div>
    <div class="d-flex justify-content-center">
        <EditForm class="w-50 mt-2 mb-4 form-container" EditContext="editContext" OnValidSubmit="@handleSubmit" FormName="NewUser">
            <div class="flex-column">
                <div class="">
                    <div class="">
                        <label>First Name:</label>
                    </div>
                    <div class="">
                        <InputText @bind-Value="formModel!.FirstName" />
                    </div>
                </div>
                <div class="">
                    <div class="">
                        <label>Last Name:</label>
                    </div>
                    <div class="">
                        <InputText @bind-Value="formModel!.LastName" />
                    </div>
                </div>
                <div class="">
                    <div class="">
                        <label>Email:</label>
                    </div>
                    <div class="">
                        <InputText @bind-Value="formModel!.Email" />
                    </div>
                </div>
            </div>
            <div class="pt-3">
                <button type="submit">Update</button>
            </div>
        </EditForm>
    </div>
</div>

@code {

    [Parameter]
    public int UserId { get; set; }

    private EditContext? editContext;
    private ValidationMessageStore? messageStore;
    private string response;

    [SupplyParameterFromForm]
    public User? formModel { get; set; }

    protected override async Task OnInitializedAsync()
    {
        formModel ??= new();
        editContext = new(formModel);
        messageStore = new(editContext);
        response = string.Empty;
        //get user from id.
        var user = _userDb.GetUserById(UserId);
        //set formModel to the user.
        formModel = user;
    }

    public void handleSubmit()
    {
        var success = _userDb.UpdateUserDb(formModel!);

        if (success)
        {
            response = "User Updated.";
            _navigationManager.NavigateTo("/users", true);
        }
        else response = "User not found";

        _navigationManager.NavigateTo("/users", true);
    }

}
