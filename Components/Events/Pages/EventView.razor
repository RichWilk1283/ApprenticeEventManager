@page "/events/{eventId:int}"

@rendermode InteractiveServer
@inject NavigationManager _navigationManager
@inject EventDb _eventDb
@inject UserDb _userDb

@using ApprenticeEventManager.DatabaseServices
@using ApprenticeEventManager.Models

@if (DbEvent == null)
{
    <p>Loading...</p>
}
else
{
    <div class="container vw-100">
        <div class="page-title-container">
            <h2 class="page-title-heading">Sign Up:</h2>
        </div>
        <div class="d-flex justify-content-center">
            <div class="w-50 mt-2 mb-4 form-container">
                <div class="flex-column">
                    <div class="">
                        <div class="">
                            <label>Name:</label>
                        </div>
                        <div class="">
                            <p>@DbEvent.Name</p>
                        </div>
                    </div>
                    <div class="">
                        <div class="">
                            <label>Description:</label>
                        </div>
                        <div class="">
                            <p>@DbEvent.Description</p>
                        </div>
                    </div>
                    <div class="">
                        <div class="">
                            <label>Date:</label>
                        </div>
                        <div class="">
                            <p>@DbEvent.Date</p>
                        </div>
                    </div>
                    <div class="pt-3">
                        <button @onclick="@(() => HandleSignUp())">Sign Up</button>
                    </div>
                </div>
            </div>
        </div>
        @if (DbUsers == null)
        {
            <p>Loading...</p>
        }
        else
        {
            <div class="row">
                @foreach (var user in DbUsers)
                {
                    <div class="card p-3 m-1">
                        <div class="card-body">
                            <h4 class="card-title">@user.LastName, @user.FirstName</h4>
                            <p class="card-text">@user.Email</p>
                            @* <a href="#" class="card-link" @onclick="@(()=> HandleUpdate(user))">Update</a>
                            <a href="#" class="card-link" @onclick="@(async ()=> await HandleDelete(user))">Delete</a> *@
                        </div>
                    </div>
                }
            </div>
        }
    </div>


}


@code {
    [Parameter]
    public int EventId { get; set; }
    private Event? DbEvent;
    private List<User>? DbUsers;
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        DbEvent = _eventDb.GetEventById(EventId);
        DbUsers = _eventDb.GetAllUsersForEvent(EventId);
        //retieve all users signed up to this
    }

    public async Task HandleSignUp()
    {
        var authState = await AuthenticationStateTask;
        var user = authState.User;
        var userEmail = user.Identity.Name;
        User dBUser = _userDb.GetUserByEmail(userEmail);
        _eventDb.AddUserToEvent(EventId, dBUser.Id);
        _navigationManager.NavigateTo("/events", true);
    }

}
