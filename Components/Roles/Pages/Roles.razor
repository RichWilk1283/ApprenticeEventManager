@page "/roles"
@* @attribute [Authorize(Roles = "Admin")] *@

@rendermode InteractiveServer
@inject NavigationManager _navigationManager
@inject RoleDb _roleDb

@using ApprenticeEventManager.DatabaseServices
@using ApprenticeEventManager.Models
@using System.Diagnostics
@using System.ComponentModel.DataAnnotations
@using System.Text.RegularExpressions


<div class="container vw-100">
    <div class="page-title-container">
        <h2 class="page-title-heading">New Roles</h2>
    </div>
    <div class="d-flex justify-content-center">
        <EditForm class="w-50 mt-2 mb-4 form-container" EditContext="editContext" OnValidSubmit="@HandleSubmit" FormName="NewRole">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <div class="flex-column">
                <div class="">
                    <div class="">
                        <label>Name:</label>
                    </div>
                    <div class="">
                        <InputText @bind-Value="formModel!.Name" />
                        <ValidationMessage For="@(() => formModel!.Name)" />
                    </div>
                </div>
            </div>
            <div class="pt-3">
                <button type="submit">Submit</button>
            </div>
        </EditForm>
    </div>

    @if (DbRoles == null)
    {
        <p>Loading...</p>
    }
    else
    {
        <div class="row">
            @foreach (var role in DbRoles)
            {
                <div class="card p-3 m-1">
                    <div class="card-body">
                        <h4 class="card-title">@role.Name</h4>
                        <a href="#" class="card-link" @onclick="@(()=> HandleDelete(role))">Delete</a>
                    </div>
                </div>
            }
        </div>
    }
</div>


@code {
    private EditContext? editContext;
    private ValidationMessageStore? messageStore;
    private string response;
    private List<Role> DbRoles;

    [SupplyParameterFromForm]
    public Role? formModel { get; set; }

    protected override async Task OnInitializedAsync()
    {
        formModel ??= new();
        editContext = new(formModel);
        messageStore = new(editContext);
        response = string.Empty;
        DbRoles = _roleDb.GetAllDbRoles();
    }

    public void HandleSubmit()
    {
        Role newRole = new();
        newRole.Name = formModel!.Name;
        response = _roleDb.AddRoleDb(newRole);
        _navigationManager.NavigateTo("/roles", true);
    }

    public void HandleUpdate(Role role)
    {
        //show update form?
        //call update DB function on new data
    }

    public void HandleDelete(Role role)
    {
        var success = _roleDb.RemoveRoleDb(role);
        if (success)
        {
            response = "Role Deleted.";
        }
        else response = "Role not found";

        _navigationManager.NavigateTo("/roles", true);
    }
}

