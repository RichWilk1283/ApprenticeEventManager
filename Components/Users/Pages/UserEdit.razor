@page "/user/{userId:int}"
@* @attribute [Authorize(Roles = "Admin")] *@

@rendermode InteractiveServer
@inject UserDb _userDb
@inject RoleDb _roleDb
@inject NavigationManager _navigationManager

@using ApprenticeEventManager.DatabaseServices
@using ApprenticeEventManager.Models

<div class="container vw-100">
    <div class="page-title-container">
        <h2 class="page-title-heading">Edit User</h2>
    </div>
    <div class="d-flex justify-content-center">
        <EditForm class="w-50 mt-2 mb-4 form-container" EditContext="editContext" OnValidSubmit="@HandleSubmit" FormName="NewUser">
            <div class="flex-column">
                <div class="">
                    <div class="">
                        <label>First Name:</label>
                    </div>
                    <div class="">
                        <InputText @bind-Value="formModel!.FirstName" />
                    </div>
                </div>
                <div class="">
                    <div class="">
                        <label>Last Name:</label>
                    </div>
                    <div class="">
                        <InputText @bind-Value="formModel!.LastName" />
                    </div>
                </div>
                <div class="">
                    <div class="">
                        <label>Email:</label>
                    </div>
                    <div class="">
                        <InputText @bind-Value="formModel!.Email" />
                    </div>
                </div>
            </div>
            <div class="pt-3">
                <button type="submit">Update</button>
            </div>
        </EditForm>
    </div>

    <div class="row">
        <div class="card p-3 m-1">
            <div class="card-body">
                <h4 class="card-title">Current Role:</h4>
                <p>@userRoles[0]</p>
            </div>
        </div>
    </div>

    @if (DbRoles == null)
    {
        <p>Loading...</p>
    }
    else
    {
        <div class="row">
            @foreach (var role in DbRoles)
            {
                <div class="card p-3 m-1">
                    <div class="card-body">
                        <h4 class="card-title">@role.Name</h4>
                        <a href="#" class="card-link" @onclick="@(()=> HandleAssign(role))">Assign</a>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {

    [Parameter]
    public int UserId { get; set; }

    private EditContext? editContext;
    private ValidationMessageStore? messageStore;
    private string response;
    private List<Role> DbRoles;
    private List<string> userRoles;

    [SupplyParameterFromForm]
    public User? formModel { get; set; }

    protected override async Task OnInitializedAsync()
    {
        formModel ??= new();
        editContext = new(formModel);
        messageStore = new(editContext);
        response = string.Empty;
        var user = _userDb.GetUserById(UserId);
        formModel = user;
        userRoles = _userDb.GetUserRole(user);
        DbRoles = _roleDb.GetAllDbRoles();
    }

    public void HandleSubmit()
    {
        var success = _userDb.UpdateUserDb(formModel!);

        if (success)
        {
            response = "User Updated.";
            _navigationManager.NavigateTo("/users", true);
        }
        else response = "User not found";

        _navigationManager.NavigateTo("/users", true);
    }

    public void HandleAssign(Role role)
    {
        //update users role.
        _userDb.UpdateUserRole(formModel!.Id, role.Id);
        _navigationManager.NavigateTo($"/user/{formModel!.Id}", true);
    }

}
